# ============================================
# JetrPay Backend — Environment Template
# Copy to .env and fill in real values.
# NEVER commit .env to git.
# ============================================

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_URL=https://your-backend.up.railway.app
FRONTEND_URL=https://your-frontend.vercel.app
LOG_LEVEL=info
TZ=UTC

# ─── Database (Railway PostgreSQL) ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@host:port/railway
DATABASE_POOL_SIZE=10

# ─── Redis (Railway Redis) ────────────────────────────────────────────────────
# Required — used for OTP storage, rate limiting, idempotency, token blacklist
REDIS_URL=redis://default:password@host:port

# ─── Auth / Security ─────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32  (must be 32+ chars)
JWT_SECRET=change_me_openssl_rand_hex_32
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
BCRYPT_ROUNDS=12

# 64-hex AES-256-GCM key — generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Email (Plunk) ───────────────────────────────────────────────────────────
# Used for OTP codes and transaction notifications
PLUNK_API_KEY=plunk_live_or_test_key
EMAIL_FROM=noreply@jetrpay.io
EMAIL_REPLY_TO=support@jetrpay.io
EMAIL_SERVICE=plunk

# ─── Zynta Last-Mile API ─────────────────────────────────────────────────────
# JetrPay is a Zynta partner. All KYC, FX, and bank payouts go through Zynta.
# Auth header: x-api-key (NOT Bearer)
#
# Sandbox key: sk_test_...  →  staging, no real money
# Live key:    sk_live_...  →  requires KYC approval in Zynta Dashboard
#
ZYNTA_API_KEY=sk_test_your_key_here
ZYNTA_API_URL=https://zynta-lastmile-infrastructure-api-staging.up.railway.app/api/v1
ZYNTA_WEBHOOK_SECRET=whsec_get_from_zynta_dashboard

# ─── Storage (Railway S3-compatible) ─────────────────────────────────────────
# Used for KYC document uploads
STORAGE_ENDPOINT=https://t3.storageapi.dev
STORAGE_REGION=auto
STORAGE_BUCKET=your-bucket-name
STORAGE_ACCESS_KEY_ID=your_access_key
STORAGE_SECRET_ACCESS_KEY=your_secret_key

# ─── Support ─────────────────────────────────────────────────────────────────
SUPPORT_EMAIL=support@jetrpay.io

# ─── NOT needed (handled by Zynta) ───────────────────────────────────────────
# SmileID  — Zynta handles all KYC/AML internally
# Twilio   — not in MVP; Plunk email covers all notifications
# Firebase — not in MVP
